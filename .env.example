# Generate unique values before starting: openssl rand -hex 32
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME=app
JWT_SECURITY_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRES=15
REFRESH_TOKEN_EXPIRES=30
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
DEBUG=false
CORS_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type","X-CSRF-TOKEN"]
